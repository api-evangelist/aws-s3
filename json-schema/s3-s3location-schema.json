{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S3Location",
  "type": "object",
  "properties": {
    "BucketName": {},
    "Prefix": {},
    "Encryption": {
      "type": "object",
      "properties": {
        "EncryptionType": {},
        "KMSKeyId": {},
        "KMSContext": {}
      },
      "required": [
        "EncryptionType"
      ],
      "description": "Contains the type of server-side encryption used."
    },
    "CannedACL": {},
    "AccessControlList": {},
    "Tagging": {},
    "UserMetadata": {},
    "StorageClass": {}
  },
  "required": [
    "BucketName",
    "Prefix"
  ],
  "description": "Describes an Amazon S3 location that will receive the results of the restore request."
}